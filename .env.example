RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen3.5:4b
RAG_LLM_BASE_URL=http://127.0.0.1:11434
RAG_LLM_API_KEY=

# Real semantic embeddings run locally through Ollama.
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_API_KEY=

RAG_DATABASE_PATH=data/index/dubai_rag.db
RAG_CORPUS_PATH=data/corpus
RAG_TOP_K=4
RAG_CANDIDATE_K=18
# Reranking adds a second LLM call. Enable it when quality matters more than latency.
RAG_ENABLE_RERANK=false
RAG_ENABLE_QUERY_REWRITE=false
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=450
RAG_MAX_HISTORY=6
