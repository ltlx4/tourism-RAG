RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen3.5:9b
RAG_LLM_BASE_URL=http://127.0.0.1:11434
RAG_LLM_API_KEY=

# "hash" works offline. Use "ollama" with an embedding model such as
# nomic-embed-text, or "openai" with text-embedding-3-small.
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=hash-384
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_API_KEY=

RAG_DATABASE_PATH=data/index/dubai_rag.db
RAG_CORPUS_PATH=data/corpus
RAG_TOP_K=6
RAG_CANDIDATE_K=18
RAG_ENABLE_RERANK=true
RAG_TEMPERATURE=0.2
RAG_MAX_HISTORY=6

